<div class="theme-switcher" data-theme-switcher>
    <button type="button" class="theme-trigger-btn" data-theme-trigger aria-expanded="false" aria-haspopup="true" title="Change site colors">
        <span class="theme-trigger-dot" aria-hidden="true"></span>
        <span>Colors</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="theme-popover" data-theme-popover hidden>
        <div class="theme-popover-title">Site Color Theme</div>
        <div class="theme-options-list">
            <button type="button" class="theme-option-btn is-active" data-set-theme="sunset">
                <span class="theme-swatch" style="background: linear-gradient(135deg, #f59e0b 0%, #ea580c 52%, #e11d48 100%);"></span>
                <span>Sunset Festival</span>
                <span class="theme-option-check">&#10003;</span>
            </button>
            <button type="button" class="theme-option-btn" data-set-theme="midnight">
                <span class="theme-swatch" style="background: linear-gradient(135deg, #0b0f19 0%, #fb7185 55%, #a855f7 100%);"></span>
                <span>Midnight Stage (Dark)</span>
                <span class="theme-option-check">&#10003;</span>
            </button>
            <button type="button" class="theme-option-btn" data-set-theme="ocean">
                <span class="theme-swatch" style="background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%);"></span>
                <span>Oceanic Breeze</span>
                <span class="theme-option-check">&#10003;</span>
            </button>
            <button type="button" class="theme-option-btn" data-set-theme="velvet">
                <span class="theme-swatch" style="background: linear-gradient(135deg, #9333ea 0%, #db2777 100%);"></span>
                <span>Royal Velvet</span>
                <span class="theme-option-check">&#10003;</span>
            </button>
            <button type="button" class="theme-option-btn" data-set-theme="emerald">
                <span class="theme-swatch" style="background: linear-gradient(135deg, #059669 0%, #4f46e5 100%);"></span>
                <span>Forest &amp; Indigo</span>
                <span class="theme-option-check">&#10003;</span>
            </button>
        </div>

        <label class="theme-custom-row" for="theme-custom-color">
            <span>Custom Color</span>
            <input type="color" id="theme-custom-color" class="theme-color-input" value="#e11d48" aria-label="Pick any custom site accent color">
        </label>
    </div>
</div>
