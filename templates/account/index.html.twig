{% extends 'base.html.twig' %}

{% block title %}My Tickets &amp; Purchase History — {{ customer.name }}{% endblock %}

{% block body %}
<div class="container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="page-heading">
        <div>
            <h1>{{ customer.name }}’s Account</h1>
            <p>{{ customer.email }} &middot; Member since {{ customer.createdAt|date('M j, Y') }}</p>
        </div>
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center;">
            <a href="{{ path('ticket_new') }}" class="btn btn-festival">+ Buy New QR Ticket</a>
            <form method="post" action="{{ path('account_logout') }}" style="margin:0;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_logout') }}">
                <button type="submit" class="btn btn-secondary">Sign Out</button>
            </form>
        </div>
    </div>

    <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="kpi-card">
            <div class="kpi-label"><span>Total Purchased</span></div>
            <div class="kpi-value">{{ tickets|length }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">
                <span>Ready for Entrance</span>
                <span class="badge-dot" style="background: var(--status-resolved-dot);"></span>
            </div>
            <div class="kpi-value">{{ active_tickets|length }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">
                <span>Used at Entrance</span>
                <span class="badge-dot" style="background: #ef4444;"></span>
            </div>
            <div class="kpi-value">{{ used_count }}</div>
        </div>
    </div>

    {% if active_tickets is not empty %}
        <h2 class="section-title" style="margin: 0 0 0.85rem;">Active Unused QR Tickets</h2>
        <div class="account-passes-grid">
            {% for ticket in active_tickets %}
                <div class="mini-pass-card">
                    <a href="{{ path('festival_pass_show', {token: ticket.qrToken}) }}" class="mini-qr-box" title="Open Full QR Pass">
                        {{ render_qr_svg(ticket.qrToken, 112) }}
                    </a>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.35rem;">
                            <span class="ticket-id">#{{ ticket.id }}</span>
                            <span class="badge badge-unused"><span class="badge-dot"></span>Unused</span>
                        </div>
                        <div style="font-weight:700;font-size:0.96rem;margin-bottom:0.2rem;">{{ ticket.title }}</div>
                        <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:0.7rem;">
                            Valid until {{ ticket.qrExpiresAt|date('M j, H:i') }}
                        </div>
                        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                            <a href="{{ path('festival_pass_show', {token: ticket.qrToken}) }}" class="btn btn-primary btn-sm">Open QR</a>
                            <a href="{{ path('festival_pass_qr_png', {token: ticket.qrToken}) }}" download="festival-ticket-{{ ticket.id }}-qr.png" class="btn btn-secondary btn-sm">PNG</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <section class="card">
        <div class="card-header">
            <div>
                <h2 class="section-title">Purchase History</h2>
                <p class="section-subtitle">Complete record of all tickets saved under your account in MySQL.</p>
            </div>
        </div>

        {% if tickets is empty %}
            <div class="empty-state">
                <h3>No tickets purchased yet</h3>
                <p>Buy your first ticket to generate a unique QR code and see it in your account history.</p>
                <a href="{{ path('ticket_new') }}" class="btn btn-festival">Buy QR Ticket</a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="ticket-table">
                    <thead>
                        <tr>
                            <th>Order / Ticket</th>
                            <th>Purchased On</th>
                            <th>Unique QR Token</th>
                            <th>Entrance Scan Status</th>
                            <th>Support Status</th>
                            <th style="text-align:right;">QR Pass</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ticket in tickets %}
                            <tr>
                                <td>
                                    <span class="ticket-id">#{{ ticket.id }}</span>
                                    <strong style="margin-left:0.4rem;">{{ ticket.title }}</strong>
                                </td>
                                <td style="white-space:nowrap;color:var(--text-muted);font-size:0.86rem;">
                                    {{ ticket.createdAt|date('M j, Y H:i:s') }}
                                </td>
                                <td>
                                    <code style="font-size:0.78rem;color:var(--text-muted);">{{ ticket.qrToken|slice(0, 12) }}…</code>
                                </td>
                                <td>
                                    {% if ticket.used %}
                                        <span class="badge badge-used">
                                            <span class="badge-dot"></span>
                                            Used on {{ ticket.usedAt|date('M j, H:i:s') }}
                                        </span>
                                    {% elseif ticket.qrExpired %}
                                        <span class="badge badge-expired">Expired (24h passed)</span>
                                    {% else %}
                                        <span class="badge badge-unused">
                                            <span class="badge-dot"></span>
                                            Unused &middot; Valid until {{ ticket.qrExpiresAt|date('M j, H:i') }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge badge-{{ ticket.status }}">
                                        <span class="badge-dot"></span>
                                        {{ ticket.statusLabel }}
                                    </span>
                                </td>
                                <td style="text-align:right;white-space:nowrap;">
                                    {% if ticket.qrToken %}
                                        <a href="{{ path('festival_pass_show', {token: ticket.qrToken}) }}" class="btn btn-secondary btn-sm">
                                            View QR &rarr;
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
