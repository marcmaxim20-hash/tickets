{% extends 'base.html.twig' %}

{% block title %}Create Customer Account — SwiftDesk{% endblock %}

{% block body %}
<div class="gate-wrapper" style="max-width: 480px;">
    <div class="card">
        <div class="card-header">
            <div>
                <h1 class="section-title" style="font-size: 1.35rem;">Create Customer Account</h1>
                <p class="section-subtitle">Track every ticket you purchase and access your QR codes anytime. Any tickets already bought with your email are linked automatically!</p>
            </div>
        </div>
        <div class="card-body">
            {% if error %}
                <div class="alert alert-error" role="alert">{{ error }}</div>
            {% endif %}

            <form method="post" action="{{ path('account_register') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_register') }}">

                <div class="form-group">
                    <label for="name" class="form-label">Your Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="{{ form_data.name }}"
                        class="form-control"
                        placeholder="e.g., Marc Maxim"
                        autofocus
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ form_data.email }}"
                        class="form-control"
                        placeholder="you@gmail.com"
                        required
                    >
                    <span class="form-hint">Use the same email you buy tickets with to link all past and future tickets.</span>
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        placeholder="At least 6 characters"
                        minlength="6"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-festival" style="width: 100%; margin-top: 0.5rem;">
                    Create Account
                </button>
            </form>

            <div style="margin-top: 1.35rem; padding-top: 1.1rem; border-top: 1px solid var(--border-color); text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
                Already have an account? <a href="{{ path('account_login') }}" style="font-weight: 700;">Sign In &rarr;</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
