{% extends 'base.html.twig' %}

{% block title %}Sign In — SwiftDesk{% endblock %}

{% block body %}
<div class="gate-wrapper" style="max-width: 460px;">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <div class="card-header">
            <div>
                <h1 class="section-title" style="font-size: 1.35rem;">Sign In to Your Account</h1>
                <p class="section-subtitle">Sign in as a Customer to buy &amp; view your QR tickets, or as an Organizer to create new events.</p>
            </div>
        </div>
        <div class="card-body">
            {% if error %}
                <div class="alert alert-error" role="alert">{{ error }}</div>
            {% endif %}

            <form method="post" action="{{ path('account_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_login') }}">

                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ entered_email }}"
                        class="form-control"
                        placeholder="you@gmail.com"
                        autofocus
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        placeholder="Enter your password"
                        required
                    >
                    <div class="password-help-row">
                        <a href="{{ path('account_forgot_password') }}" id="forgot-password-link" class="forgot-password-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
                            <span>Forgot your password?</span>
                        </a>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.35rem;">
                    Sign In
                </button>
            </form>

            <div style="margin-top: 1.35rem; padding-top: 1.15rem; border-top: 1px solid var(--border-color); text-align: center; font-size: 0.9rem;">
                New customer? <a href="{{ path('account_register') }}" style="font-weight: 700;">Register Account &rarr;</a>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var emailInput = document.getElementById('email');
    var forgotLink = document.getElementById('forgot-password-link');
    if (!emailInput || !forgotLink) {
        return;
    }
    var baseHref = forgotLink.getAttribute('href');
    forgotLink.addEventListener('click', function () {
        var email = emailInput.value.trim();
        if (email !== '') {
            forgotLink.setAttribute('href', baseHref + '?email=' + encodeURIComponent(email));
        } else {
            forgotLink.setAttribute('href', baseHref);
        }
    });
});
</script>
{% endblock %}
