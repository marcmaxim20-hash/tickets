{% extends 'base.html.twig' %}

{% block title %}Recover Password — SwiftDesk{% endblock %}

{% block body %}
<div class="gate-wrapper" style="max-width: 470px;">
    <div class="card">
        <div class="card-header">
            <div>
                <h1 class="section-title" style="font-size: 1.35rem;">Recover Password</h1>
                <p class="section-subtitle">Enter your account email and we will send you a 1-hour link to set a new password.</p>
            </div>
        </div>
        <div class="card-body">
            {% if error %}
                <div class="alert alert-error" role="alert">{{ error }}</div>
            {% endif %}

            {% if sent_message %}
                <div class="alert alert-success" role="status">{{ sent_message }}</div>

                {% if local_fallback_reset_url %}
                    <div class="alert alert-warning" role="status" style="display:block;">
                        <strong>Local Dev Reset Link:</strong><br>
                        <span style="font-size:0.84rem;">SMTP did not deliver the email locally — click below to complete your password reset now:</span><br>
                        <a href="{{ local_fallback_reset_url }}" class="btn btn-primary btn-sm" style="margin-top:0.6rem;">
                            Open Password Reset Page &rarr;
                        </a>
                    </div>
                {% endif %}
            {% endif %}

            <form method="post" action="{{ path('account_forgot_password') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_forgot_password') }}">

                <div class="form-group">
                    <label for="email" class="form-label">Account Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ entered_email }}"
                        class="form-control"
                        placeholder="you@gmail.com"
                        autofocus
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    Send Password Recovery Link
                </button>
            </form>

            <div style="margin-top: 1.35rem; padding-top: 1.15rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; font-size: 0.88rem;">
                <a href="{{ path('account_login') }}">&larr; Back to Sign In</a>
                <a href="{{ path('account_register') }}" style="font-weight: 700;">Register Account</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
