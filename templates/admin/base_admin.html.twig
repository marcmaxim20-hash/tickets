<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Staff &amp; Admin — SwiftDesk{% endblock %}</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('swiftdesk_theme');
                if (t && t !== 'sunset') document.documentElement.setAttribute('data-theme', t);
                if (t === 'custom') {
                    var c = localStorage.getItem('swiftdesk_custom_color');
                    if (c) document.documentElement.style.setProperty('--custom-accent', c);
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}?v=5">
    <script src="{{ asset('js/ui.js') }}?v=5" defer></script>
</head>
<body>
    {% set is_admin = app.session.get('admin_role_authenticated') == true %}
    {% set is_staff = app.session.get('staff_scanner_authenticated') == true %}
    <header class="admin-header">
        <div class="container header-inner">
            <div style="display:flex;align-items:center;gap:0.75rem;">
                <a href="{{ is_admin ? path('admin_dashboard') : path('ticket_home') }}" class="brand">
                    <span class="brand-mark" aria-hidden="true">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <span>SwiftDesk</span>
                </a>
                <span class="admin-badge">{{ is_admin ? 'Administrator' : 'Entrance Staff' }}</span>
            </div>

            <nav class="nav-links" aria-label="Admin Navigation" style="flex-wrap:wrap;">
                {% if is_admin %}
                    <a href="{{ path('admin_events_new') }}" class="btn btn-festival btn-sm">
                        + Create New Event
                    </a>
                    <a href="{{ path('admin_events_index') }}" class="admin-nav-link {{ app.current_route == 'admin_events_index' or app.current_route == 'admin_events_edit' ? 'active' : '' }}">
                        Events &amp; Photos
                    </a>
                    <a href="{{ path('admin_dashboard') }}" class="admin-nav-link {{ app.current_route == 'admin_dashboard' or app.current_route == 'admin_ticket_show' ? 'active' : '' }}">
                        All Tickets
                    </a>
                {% endif %}
                {% if is_admin or is_staff %}
                    <a href="{{ path('staff_scanner') }}" class="admin-nav-link {{ app.current_route starts with 'staff_scanner' ? 'active' : '' }}">
                        Entrance QR Scanner
                    </a>
                {% endif %}
                <a href="{{ path('ticket_home') }}" class="admin-nav-link">
                    Public Site &nearr;
                </a>
                {{ include('_theme_switcher.html.twig') }}
                {% if is_admin or is_staff %}
                    <form method="post" action="{{ path('admin_logout') }}" style="margin:0;">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_logout') }}">
                        <button type="submit" class="btn btn-sm btn-ghost-dark">Sign Out</button>
                    </form>
                {% endif %}
            </nav>
        </div>
    </header>

    <main>
        <div class="container">
            {% for message in app.flashes('admin_success') %}
                <div class="alert alert-success" role="status">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('admin_error') %}
                <div class="alert alert-error" role="alert">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('admin_info') %}
                <div class="alert alert-info" role="status">{{ message }}</div>
            {% endfor %}

            {% block admin_body %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>SwiftDesk Staff &amp; Admin Console &middot; Single-Use QR Verification</span>
            <a href="{{ path('ticket_home') }}">&larr; Back to Visitor Portal</a>
        </div>
    </footer>
</body>
</html>
