{% extends 'admin/base_admin.html.twig' %}

{% block title %}Events &amp; Venues — Admin Panel{% endblock %}

{% block admin_body %}
<div class="page-heading">
    <div>
        <h1>Events, Venues &amp; Seat Capacities</h1>
        <p>Create Concerts, Theatre shows, and Festivals, upload cover images, set Start–End dates, and track available seats.</p>
    </div>
    <a href="{{ path('admin_events_new') }}" class="btn btn-festival">+ Create New Event</a>
</div>

<section class="card">
    {% if events is empty %}
        <div class="empty-state">
            <h3>No events created yet</h3>
            <p>Create your first Concert, Theatre show, or Festival with an image and venue capacity.</p>
            <a href="{{ path('admin_events_new') }}" class="btn btn-festival">Create Event</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="ticket-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Event &amp; Type</th>
                        <th>Venue &amp; Location</th>
                        <th>Start &ndash; End Date</th>
                        <th>Seats Available</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                        <tr>
                            <td style="width:110px;">
                                <img src="{{ event.displayImageUrl }}" alt="{{ event.title }}" style="width:92px;height:58px;object-fit:cover;border-radius:8px;border:1px solid var(--border-color);display:block;">
                            </td>
                            <td>
                                <strong>{{ event.title }}</strong>
                                <div style="margin-top:0.2rem;display:flex;gap:0.35rem;flex-wrap:wrap;align-items:center;">
                                    <span class="badge badge-festival">{{ event.categoryLabel }}</span>
                                    {% if event.seatMapEnabled %}
                                        <span class="badge badge-seat-map" style="font-size:0.7rem;">Seat Map {{ event.seatRows }}&times;{{ event.seatsPerRow }}</span>
                                    {% endif %}
                                    {% if event.organizer %}
                                        <span class="badge badge-organizer" style="font-size:0.7rem;">By {{ event.organizer.name }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <div style="font-weight:600;">{{ event.venue }}</div>
                                {% if event.location %}
                                    <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:0.15rem;">
                                        {{ event.location }}
                                        {% if event.mapsUrl %}
                                            &middot; <a href="{{ event.mapsUrl }}" target="_blank" rel="noopener noreferrer">Maps &nearr;</a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </td>
                            <td style="font-size:0.84rem;color:var(--text-secondary);white-space:nowrap;">
                                {{ event.startDate|date('M j, Y H:i') }}<br>
                                &rarr; {{ event.endDate|date('M j, Y H:i') }}
                            </td>
                            <td>
                                {% if event.soldOut %}
                                    <span class="badge badge-used">Sold Out (0 / {{ event.totalSeats }})</span>
                                {% else %}
                                    <span class="badge badge-unused">{{ event.availableSeats }} / {{ event.totalSeats }} left</span>
                                {% endif %}
                            </td>
                            <td style="text-align:right;white-space:nowrap;">
                                <form method="post" action="{{ path('admin_events_update_photo', {id: event.id}) }}" enctype="multipart/form-data" style="display:inline-block;margin:0;">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('event_photo_' ~ event.id) }}">
                                    <input type="hidden" name="redirect_to" value="events">
                                    <label class="btn btn-primary btn-sm photo-upload-btn">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        <span>Change Photo</span>
                                        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" hidden onchange="this.form.submit()">
                                    </label>
                                </form>
                                <a href="{{ path('admin_events_seats', {id: event.id}) }}" class="btn btn-festival btn-sm" style="margin-left:0.3rem;">Arrange Seats</a>
                                <a href="{{ path('admin_events_edit', {id: event.id}) }}" class="btn btn-secondary btn-sm" style="margin-left:0.3rem;">Edit</a>
                                <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-secondary btn-sm" style="margin-left:0.3rem;">View</a>
                                <form method="post" action="{{ path('admin_events_delete', {id: event.id}) }}" style="display:inline-block;margin:0 0 0 0.3rem;" onsubmit="return confirm('Delete event &quot;{{ event.title|e('js') }}&quot;? This cannot be undone.');">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                    <input type="hidden" name="redirect_to" value="events">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}
