{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ is_edit ? 'Edit Event' : 'Create Event' }} — Admin Panel{% endblock %}

{% block admin_body %}
<div class="container-narrow" style="max-width: 1240px; padding: 0;">
    <div class="breadcrumb">
        <a href="{{ path('admin_events_index') }}">&larr; Back to Events &amp; Venues</a>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h1 class="section-title" style="font-size: 1.35rem;">
                    {{ is_edit ? 'Edit Event: ' ~ event.title : 'Create New Event' }}
                </h1>
                <p class="section-subtitle">Set the venue capacity (seats), start &amp; end dates, and upload an event cover image.</p>
            </div>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                <div class="form-grid-2">
                    <div class="form-group">
                        {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-errors">{{ form_errors(form.title) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.category, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                        <div class="form-errors">{{ form_errors(form.category) }}</div>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        {{ form_label(form.venue, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.venue, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-errors">{{ form_errors(form.venue) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.totalSeats, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.totalSeats, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-errors">{{ form_errors(form.totalSeats) }}</div>
                        {% if is_edit %}
                            <span class="form-hint">Currently {{ event.soldTicketsCount }} ticket(s) sold ({{ event.availableSeats }} available).</span>
                        {% endif %}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.location, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-errors">{{ form_errors(form.location) }}</div>
                    <span class="form-hint">Enter the full street address or location so guests know where to go.</span>
                    {{ include('event/_location_map_preview.html.twig', {event: event}) }}
                </div>

                {{ include('event/_seat_map_builder.html.twig', {
                    form: form,
                    is_edit: is_edit,
                    initial_seat_config: initial_seat_config|default(null),
                    taken_seats: taken_seats|default([])
                }) }}

                <div class="form-grid-2">
                    <div class="form-group">
                        {{ form_label(form.startDate, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.startDate, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-errors">{{ form_errors(form.startDate) }}</div>
                    </div>

                    <div class="form-group">
                        {{ form_label(form.endDate, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-errors">{{ form_errors(form.endDate) }}</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Festival / Event Cover Photo</label>

                    <div class="photo-preview-stage">
                        <img
                            id="event-photo-preview"
                            src="{{ event.displayImageUrl }}"
                            alt="Event cover preview"
                            class="photo-preview-img"
                        >
                        <div class="photo-preview-controls">
                            <div>
                                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label', 'style': 'font-size:0.85rem;'}}) }}
                                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                                <div class="form-errors">{{ form_errors(form.imageFile) }}</div>
                                <span class="form-hint">Upload any JPG, PNG, WEBP, AVIF, GIF, or SVG image (up to 16 MB).</span>
                            </div>

                            <div style="margin-top: 0.85rem;">
                                {{ form_label(form.imageUrl, null, {'label_attr': {'class': 'form-label', 'style': 'font-size:0.85rem;'}}) }}
                                {{ form_widget(form.imageUrl, {'attr': {'class': 'form-control'}}) }}
                                <div class="form-errors">{{ form_errors(form.imageUrl) }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                {{ include('event/_ai_description_field.html.twig', {form: form}) }}

                <div class="form-actions">
                    <a href="{{ path('admin_events_index') }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-festival">
                        {{ is_edit ? 'Save Event & Photo Changes' : 'Create Event' }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var preview = document.getElementById('event-photo-preview');
    var fileInput = document.querySelector('input[type="file"][name$="[imageFile]"]');
    var urlInput = document.querySelector('input[name$="[imageUrl]"]');
    var categorySelect = document.querySelector('select[name$="[category]"]');
    if (!preview) return;

    var hasCustomImage = {{ event.imagePath ? 'true' : 'false' }};
    var defaultByCategory = {
        concert: '/images/events/concert-arena.svg',
        festival: '/images/events/festival-sunset.svg',
        theatre: '/images/events/theatre-grand.svg',
        cinema: '/images/events/cinema-screen.svg',
        comedy: '/images/events/comedy-club.svg',
        sports: '/images/events/sports-stadium.svg',
        saloon: '/images/events/saloon-hall.svg',
        building: '/images/events/building-venue.svg',
        conference: '/images/events/conference-summit.svg',
        workshop: '/images/events/workshop-studio.svg',
        nightlife: '/images/events/nightlife-club.svg',
        exhibition: '/images/events/art-exhibition.svg'
    };

    if (fileInput) {
        fileInput.addEventListener('change', function () {
            var file = fileInput.files && fileInput.files[0];
            if (file) {
                preview.src = URL.createObjectURL(file);
                hasCustomImage = true;
            }
        });
    }

    if (urlInput) {
        urlInput.addEventListener('input', function () {
            var val = urlInput.value.trim();
            if (val.indexOf('http://') === 0 || val.indexOf('https://') === 0) {
                preview.src = val;
                hasCustomImage = true;
            }
        });
    }

    if (categorySelect) {
        categorySelect.addEventListener('change', function () {
            if (!hasCustomImage && defaultByCategory[categorySelect.value]) {
                preview.src = defaultByCategory[categorySelect.value];
            }
        });
    }
});
</script>
{% endblock %}
