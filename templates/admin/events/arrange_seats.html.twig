{% extends 'admin/base_admin.html.twig' %}

{% block title %}Arrange Seat Positions — {{ event.title }} — Admin Panel{% endblock %}

{% block admin_body %}
<div class="container" style="max-width: 1360px; padding: 0;">
    <div class="breadcrumb" style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="{{ path('admin_events_index') }}">&larr; Back to Events &amp; Venues</a>
            <a href="{{ path('event_show', {id: event.id}) }}">View Public Event Page &nearr;</a>
        </div>
        <span class="badge badge-festival">Admin Seat Position Editor</span>
    </div>

    <div class="card no-reveal">
        <div class="card-header">
            <div>
                <h1 class="section-title" style="font-size: 1.35rem;">
                    Arrange Seat Positions — {{ event.title }}
                </h1>
                <p class="section-subtitle">
                    Drag seats to change their positions, click to add/remove aisles, reposition the stage (Top / Bottom / Left / Right), or paint price zones.
                </p>
            </div>
            <span id="admin-seat-total-pill" class="badge badge-festival">{{ seat_map.total_seats }} Mapped Seats</span>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_events_seats', {id: event.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('arrange_seats_' ~ event.id) }}">
                <input type="hidden" name="seat_map_config_json" id="admin-seat-config-json" value="">

                <div class="form-grid-3" style="margin-bottom: 1.15rem;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label for="admin-layout" class="form-label">Base Preset Layout</label>
                        <select id="admin-layout" name="seat_map_layout" class="form-select">
                            {% for layout_key, layout_label in available_layouts %}
                                <option value="{{ layout_key }}" {{ event.seatMapLayout == layout_key ? 'selected' : '' }}>{{ layout_label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label for="admin-rows" class="form-label">Grid Rows (1–26)</label>
                        <input type="number" id="admin-rows" name="seat_rows" class="form-control" min="1" max="26" value="{{ seat_map.editor_config.rows }}">
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label for="admin-cols" class="form-label">Seats / Row (for Preset)</label>
                        <input type="number" id="admin-cols" name="seats_per_row" class="form-control" min="2" max="20" value="{{ event.seatsPerRow }}">
                    </div>
                </div>

                {{ include('event/_seat_position_editor.html.twig', {
                    editor_id: 'admin-seat-editor',
                    hidden_input_selector: '#admin-seat-config-json',
                    layout_select_selector: '#admin-layout',
                    rows_input_selector: '#admin-rows',
                    cols_input_selector: '#admin-cols',
                    total_pill_selector: '#admin-seat-total-pill',
                    initial_config: seat_map.editor_config,
                    taken_seats: taken_seats
                }) }}

                <div class="form-actions" style="margin-top: 1.35rem;">
                    <a href="{{ path('admin_events_index') }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-festival">
                        Save Seat Positions
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
