<div class="account-menu" data-account-menu>
    <button
        type="button"
        class="account-trigger-btn {{ nav_customer ? 'is-signed-in' : '' }}"
        data-account-trigger
        aria-expanded="false"
        aria-haspopup="true"
        aria-label="{{ nav_customer ? 'Account menu (' ~ nav_customer.name ~ ')' : 'Sign In or Register' }}"
        title="{{ nav_customer ? nav_customer.name ~ ' (' ~ nav_customer.roleLabel ~ ')' : 'Account — Sign In / Register' }}"
    >
        {% if nav_customer %}
            <span class="account-avatar-dot" aria-hidden="true">{{ nav_customer.name|slice(0, 1)|upper }}</span>
        {% else %}
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
        {% endif %}
        <svg class="account-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    <div class="account-popover" data-account-popover hidden>
        {% if nav_customer %}
            <div class="account-popover-header">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                    <strong class="account-popover-name">{{ nav_customer.name }}</strong>
                    <span class="badge {{ nav_customer.organizer ? 'badge-organizer' : 'badge-resolved' }}" style="font-size:0.68rem;padding:0.15rem 0.5rem;">
                        {{ nav_customer.roleLabel }}
                    </span>
                </div>
                <div class="account-popover-email">{{ nav_customer.email }}</div>
            </div>

            <div class="account-menu-list">
                <a href="{{ path('account_dashboard') }}" class="account-menu-item {{ app.current_route == 'account_dashboard' ? 'is-active' : '' }}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>{{ nav_customer.organizer ? 'Organizer Hub' : 'My Account & Tickets' }}</span>
                </a>

                {% if nav_customer.organizer %}
                    <a href="{{ path('organizer_events_new') }}" class="account-menu-item {{ app.current_route == 'organizer_events_new' ? 'is-active' : '' }}">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>Create New Event</span>
                    </a>
                {% elseif menu_qr_ticket %}
                    <a href="{{ path('festival_pass_show', {token: menu_qr_ticket.qrToken}) }}" class="account-menu-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3z"/><path d="M18 18h3v3h-3z"/></svg>
                        <span>See My QR Pass</span>
                    </a>
                {% endif %}

                <a href="{{ path('account_register') }}" class="account-menu-item {{ app.current_route == 'account_register' ? 'is-active' : '' }}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    <span>Register New Account</span>
                </a>

                {% if app.session.get('admin_role_authenticated') == true %}
                    <a href="{{ path('admin_dashboard') }}" class="account-menu-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span>Admin Panel</span>
                    </a>
                {% endif %}
            </div>

            <div class="account-menu-divider"></div>

            <form method="post" action="{{ path('account_logout') }}" style="margin:0;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_logout') }}">
                <button type="submit" class="account-menu-item account-menu-danger">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Sign Out</span>
                </button>
            </form>
        {% else %}
            <div class="theme-popover-title">Account</div>
            <div class="account-menu-list">
                <a href="{{ path('account_login') }}" class="account-menu-item {{ app.current_route == 'account_login' ? 'is-active' : '' }}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    <span>Sign In</span>
                </a>

                <a href="{{ path('account_register') }}" class="account-menu-item {{ app.current_route == 'account_register' ? 'is-active' : '' }}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    <span>Register Account</span>
                </a>
            </div>

            <div class="account-menu-divider"></div>

            <div class="account-menu-list">
                {% if app.session.get('admin_role_authenticated') == true %}
                    <a href="{{ path('admin_dashboard') }}" class="account-menu-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span>Admin Panel</span>
                    </a>
                {% else %}
                    <a href="{{ path('admin_login') }}" class="account-menu-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span>Admin Login</span>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
