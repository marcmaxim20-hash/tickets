{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="form-group">
        <label for="event_id" class="form-label">Event &amp; Venue</label>
        <select
            id="event_id"
            name="event_id"
            class="form-select"
            onchange="window.location.href = '{{ path('ticket_new') }}?event=' + this.value"
        >
            {% for ev in all_events %}
                <option value="{{ ev.id }}" {{ ev.id == selected_event.id ? 'selected' : '' }} {{ ev.soldOut ? 'disabled' : '' }}>
                    [{{ ev.categoryLabel }}] {{ ev.title }} — {{ ev.venue }} ({{ ev.availableSeats }}/{{ ev.totalSeats }} seats left)
                </option>
            {% endfor %}
        </select>
    </div>

    <div style="display:flex;gap:1rem;align-items:center;padding:0.9rem 1rem;background:var(--bg-subtle);border:1px solid var(--border-color);border-radius:12px;margin-bottom:1.35rem;">
        <img src="{{ selected_event.displayImageUrl }}" alt="{{ selected_event.title }}" style="width:88px;height:62px;object-fit:cover;border-radius:8px;flex-shrink:0;">
        <div style="font-size:0.85rem;line-height:1.45;">
            <strong style="font-size:0.96rem;color:var(--text-main);display:block;">{{ selected_event.title }} ({{ selected_event.categoryLabel }})</strong>
            <span><strong>Venue:</strong> {{ selected_event.venue }} &middot; <strong>Seats left:</strong> {{ selected_event.availableSeats }}/{{ selected_event.totalSeats }}</span><br>
            {% if selected_event.location %}
                <span>
                    <strong>Location:</strong> {{ selected_event.location }}
                    {% if selected_event.mapsUrl %}
                        &middot; <a href="{{ selected_event.mapsUrl }}" target="_blank" rel="noopener noreferrer" style="font-weight:700;">Open in Maps &nearr;</a>
                    {% endif %}
                </span><br>
            {% endif %}
            <span><strong>Dates:</strong> {{ selected_event.startDate|date('M j, Y H:i') }} &ndash; {{ selected_event.endDate|date('M j, Y H:i') }}</span>
        </div>
    </div>

    {{ form_widget(form.seatLabel) }}

    <div class="form-group">
        <label class="form-label">
            {{ seat_map is defined and seat_map ? 'Ticket Tier (Matched to Your Selected Seat Zone)' : 'Select Ticket Tier' }}
        </label>
        <div class="tier-selector-grid">
            {% for child in form.tierKey %}
                {% set tier_key = child.vars.value %}
                {% set tier_info = tiers[tier_key] %}
                <label class="tier-radio-option" data-tier-card="{{ tier_key }}">
                    {{ form_widget(child, {'attr': {'data-price': tier_info.price_display}}) }}
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                            <strong style="font-size:0.95rem;">{{ tier_info.name }}</strong>
                            <span class="price-tag">{{ tier_info.price_display }}</span>
                        </div>
                        <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:0.2rem;">
                            {{ tier_info.summary }}
                        </div>
                    </div>
                </label>
            {% endfor %}
        </div>
        <div class="form-errors">{{ form_errors(form.tierKey) }}</div>
    </div>

    {% if seat_map is defined and seat_map %}
        {% if seat_error is defined and seat_error %}
            <div class="alert alert-error" role="alert" style="margin-top:1rem;margin-bottom:1rem;">{{ seat_error }}</div>
        {% endif %}
        <div class="form-group" style="margin-top:1.35rem;margin-bottom:1.5rem;">
            {{ include('event/_seat_map_picker.html.twig', {
                event: selected_event,
                seat_map: seat_map,
                mode: 'checkout',
                selected_seat: selected_seat
            }) }}
        </div>
    {% endif %}

    <div class="form-group" style="margin-top:1.35rem;">
        {{ form_label(form.contact, 'Account Email', {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.contact, {'attr': {'class': 'form-control', 'readonly': 'readonly'}}) }}
        <div class="form-errors">{{ form_errors(form.contact) }}</div>
        <span class="form-hint">Signed in as <strong>{{ customer.name }}</strong> — only your account ({{ customer.email }}) can view this ticket.</span>
    </div>

    <div class="form-actions">
        <a href="{{ path('event_show', {id: selected_event.id}) }}" class="btn btn-secondary">Back to Event</a>
        <button type="submit" id="buy-submit-btn" class="btn btn-festival" {{ selected_event.soldOut ? 'disabled' : '' }}>
            Buy Ticket
        </button>
    </div>
{{ form_end(form) }}

<script>
(() => {
    const btn = document.getElementById('buy-submit-btn');
    const radios = document.querySelectorAll('input[name="ticket[tierKey]"]');
    const seatInput = document.querySelector('input[name="ticket[seatLabel]"]');
    const seatButtons = document.querySelectorAll('.seat-btn[data-seat-label]');
    const hasSeatMap = seatButtons.length > 0;
    const banner = document.getElementById('selected-seat-banner');
    const badgeEl = document.getElementById('selected-seat-code');
    const detailsEl = document.getElementById('selected-seat-details');

    const syncButtonAndBanner = (activeSeatBtn) => {
        const checked = document.querySelector('input[name="ticket[tierKey]"]:checked');
        const price = activeSeatBtn?.getAttribute('data-price') || checked?.getAttribute('data-price');
        const seatLabel = seatInput ? seatInput.value.trim().toUpperCase() : '';

        if (hasSeatMap && banner && badgeEl && detailsEl) {
            if (activeSeatBtn && seatLabel) {
                const row = activeSeatBtn.getAttribute('data-seat-row');
                const col = activeSeatBtn.getAttribute('data-seat-col');
                const tierName = activeSeatBtn.getAttribute('data-tier-name');
                const seatPrice = activeSeatBtn.getAttribute('data-price');
                banner.classList.add('has-seat');
                badgeEl.classList.remove('seat-pill-empty');
                badgeEl.textContent = `Seat ${seatLabel} · 1 Person`;
                detailsEl.innerHTML = `<strong>Row ${row}, Seat ${col}</strong> (1 Person Only) &middot; ${tierName} (<strong>${seatPrice}</strong>)`;
            } else {
                banner.classList.remove('has-seat');
                badgeEl.classList.add('seat-pill-empty');
                badgeEl.textContent = 'No Seat Selected';
                detailsEl.textContent = 'Click an available seat on the map below to choose your spot.';
            }
        }

        if (btn && !btn.disabled) {
            if (hasSeatMap) {
                btn.textContent = seatLabel && price
                    ? `Buy Seat ${seatLabel} for ${price}`
                    : 'Choose a Seat on the Map to Buy';
            } else if (price) {
                btn.textContent = `Buy Ticket for ${price}`;
            }
        }
    };

    const selectSeatButton = (targetBtn) => {
        seatButtons.forEach((b) => {
            const isTarget = b === targetBtn;
            b.classList.toggle('is-selected', isTarget);
            b.setAttribute('aria-pressed', isTarget ? 'true' : 'false');
        });

        if (targetBtn && seatInput) {
            seatInput.value = targetBtn.getAttribute('data-seat-label') || '';
            const tierKey = targetBtn.getAttribute('data-tier-key');
            if (tierKey) {
                const matchingRadio = document.querySelector(`input[name="ticket[tierKey]"][value="${tierKey}"]`);
                if (matchingRadio) {
                    matchingRadio.checked = true;
                }
            }
        }

        syncButtonAndBanner(targetBtn);
    };

    seatButtons.forEach((seatBtn) => {
        seatBtn.addEventListener('click', () => selectSeatButton(seatBtn));
    });

    radios.forEach((r) => {
        r.addEventListener('change', () => {
            if (hasSeatMap) {
                document.querySelectorAll('.seat-row').forEach((rowEl) => {
                    rowEl.classList.toggle('is-tier-focus', rowEl.getAttribute('data-tier-key') === r.value);
                });
            }
            const currentBtn = document.querySelector('.seat-btn.is-selected');
            syncButtonAndBanner(currentBtn);
        });
    });

    // Initialize state (e.g. if ?seat=C4 was passed from the event page)
    const initialSeat = seatInput ? seatInput.value.trim().toUpperCase() : '';
    const initialBtn = initialSeat
        ? document.querySelector(`.seat-btn[data-seat-label="${initialSeat}"]`)
        : null;
    if (initialBtn) {
        selectSeatButton(initialBtn);
    } else {
        syncButtonAndBanner(null);
    }
})();
</script>
