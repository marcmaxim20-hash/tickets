{% extends 'base.html.twig' %}

{% block title %}SwiftDesk — Concerts, Theatre &amp; Festival Tickets{% endblock %}

{% block body %}
{% set customer = current_customer() %}
<div class="container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning" role="alert">{{ message }}</div>
    {% endfor %}

    <section class="hero-card" style="padding: 2.75rem 2rem;">
        <div class="hero-eyebrow">
            <span class="hero-live-dot" aria-hidden="true"></span>
            <span>Concerts &middot; Theatre &middot; Festivals &middot; Live Seat Availability</span>
        </div>

        <h1 class="hero-title">Discover Events &amp; <span class="hero-gradient-text">Book Your Seats</span></h1>
        <p class="hero-subtitle">
            Choose a Concert, Theatre Gala, or Festival below, check live seat availability and event dates, and purchase private QR tickets starting at <strong>19$</strong>.
        </p>

        <div class="hero-actions">
            {% if customer and customer.organizer %}
                <a href="{{ path('organizer_events_new') }}" class="btn btn-festival btn-lg">
                    + Create New Event
                </a>
                <a href="{{ path('account_dashboard') }}" class="btn btn-primary btn-lg">
                    Organizer Hub
                </a>
            {% else %}
                <a href="#events-showcase" class="btn btn-festival btn-lg">
                    Explore Upcoming Events
                </a>
                {% if customer %}
                    <a href="{{ path('account_dashboard') }}" class="btn btn-primary btn-lg">
                        My Account ({{ my_tickets_count }} Ticket{{ my_tickets_count == 1 ? '' : 's' }})
                    </a>
                {% else %}
                    <a href="{{ path('account_login') }}" class="btn btn-secondary btn-lg">
                        Sign In to View Your Tickets
                    </a>
                {% endif %}
            {% endif %}
        </div>

        <div class="hero-flow-strip" aria-label="How booking works">
            <span class="hero-flow-step"><span class="hero-flow-num">1</span> Pick an Event &amp; Tier</span>
            <span class="hero-flow-step"><span class="hero-flow-num">2</span> Receive Instant Private QR</span>
            <span class="hero-flow-step"><span class="hero-flow-num">3</span> Single-Scan Entry at Venue</span>
        </div>
    </section>

    <section id="events-showcase" style="margin-top: 2.35rem;" aria-labelledby="events-heading">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <div>
                <h2 id="events-heading" class="section-title" style="font-size: 1.45rem;">Upcoming Events</h2>
                <p class="section-subtitle">Pick an event to see available seats, start &amp; end dates, and ticket tiers (19$ – 149$).</p>
            </div>

            <div class="events-controls">
                <div class="live-search-box">
                    <span class="live-search-icon" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </span>
                    <input
                        type="search"
                        id="event-live-search"
                        class="live-search-input"
                        placeholder="Search event, venue, or location..."
                        aria-label="Filter events by title, venue, or location"
                    >
                    <button type="button" id="event-search-clear" class="live-search-clear" aria-label="Clear search" hidden>&times;</button>
                </div>

                <div class="filter-tabs" role="tablist" aria-label="Filter by event category">
                    <a href="{{ path('ticket_home') }}" class="filter-tab {{ active_category is null ? 'active' : '' }}">
                        All Events
                    </a>
                    {% for cat_key, cat_label in categories %}
                        <a href="{{ path('ticket_home', {category: cat_key}) }}" class="filter-tab {{ active_category == cat_key ? 'active' : '' }}">
                            {{ cat_label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% if events is empty %}
            <div class="card empty-state" style="margin-top: 1.25rem;">
                <h3>No events in this category yet</h3>
                <p>Switch to All Events above to explore upcoming concerts, theatre shows, and festivals.</p>
                <a href="{{ path('ticket_home') }}" class="btn btn-primary btn-sm">Show All Events</a>
            </div>
        {% else %}
            <div id="events-search-empty" class="card empty-state" style="margin-top: 1.25rem;" hidden>
                <h3>No matching events found</h3>
                <p>Try searching for a different artist, festival, or venue name.</p>
            </div>

            <div class="events-grid">
                {% for event in events %}
                    <article class="event-card" data-search-text="{{ event.title }} {{ event.venue }} {{ event.location }} {{ event.categoryLabel }}">
                        <a href="{{ path('event_show', {id: event.id}) }}" class="event-card-media">
                            <img src="{{ event.displayImageUrl }}" alt="{{ event.title }}">
                            <span class="event-category-pill">{{ event.categoryLabel }}</span>
                            {% if not event.soldOut %}
                                <span class="event-price-pill">from 19$</span>
                            {% endif %}
                        </a>

                        <div class="event-card-body">
                            <h3 class="event-card-title">
                                <a href="{{ path('event_show', {id: event.id}) }}" style="color:inherit;">{{ event.title }}</a>
                            </h3>

                            <div class="event-meta-row">
                                <strong>Place:</strong>
                                <span>{{ event.venue }}</span>
                            </div>

                            {% if event.location %}
                                <div class="event-meta-row">
                                    <strong>Location:</strong>
                                    <span>
                                        {{ event.location }}
                                        {% if event.mapsUrl %}
                                            &middot; <a href="{{ event.mapsUrl }}" target="_blank" rel="noopener noreferrer" style="font-weight:700;">Maps &nearr;</a>
                                        {% endif %}
                                    </span>
                                </div>
                            {% endif %}

                            <div class="event-meta-row">
                                <strong>Start:</strong>
                                <span>{{ event.startDate|date('M j, Y H:i') }}</span>
                            </div>

                            <div class="event-meta-row">
                                <strong>End:</strong>
                                <span>{{ event.endDate|date('M j, Y H:i') }}</span>
                            </div>

                            <div class="seats-meter">
                                <div class="seats-meter-top">
                                    {% if event.soldOut %}
                                        <span style="color: var(--danger-text);">SOLD OUT (0 / {{ event.totalSeats }} seats left)</span>
                                    {% else %}
                                        <span style="color: var(--status-resolved-text);">{{ event.availableSeats }} of {{ event.totalSeats }} seats available</span>
                                    {% endif %}
                                    <span style="color: var(--text-muted);">{{ event.soldTicketsCount }} bought</span>
                                </div>
                                <div class="seats-bar">
                                    <div class="seats-bar-fill {{ event.soldOut ? 'sold-out' : '' }}" style="width: {{ event.occupancyPercent }}%;"></div>
                                </div>
                            </div>

                            <div style="margin-top: auto;">
                                {% if event.soldOut %}
                                    <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-secondary" style="width: 100%;">
                                        Sold Out — View Details
                                    </a>
                                {% elseif customer and customer.organizer %}
                                    <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-secondary" style="width: 100%;">
                                        View Event Details &rarr;
                                    </a>
                                {% else %}
                                    <a href="{{ path('event_show', {id: event.id}) }}" class="btn btn-festival" style="width: 100%;">
                                        Choose Seats &amp; Buy (from 19$) &rarr;
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
