<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Your Festival Door 24h QR Ticket</title>
</head>
<body style="margin:0;padding:24px;background-color:#fffaf5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f120f;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background-color:#ffffff;border:1px solid #f3dfd3;border-radius:16px;overflow:hidden;">
        <tr>
            <td style="background:linear-gradient(135deg,#c2410c 0%,#e11d48 100%);background-color:#ea580c;padding:24px 28px;color:#ffffff;text-align:center;">
                <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;opacity:0.9;">Festival Main Gate Pass</div>
                <strong style="font-size:21px;display:block;margin-top:4px;">Festival Door QR Ticket (#{{ ticket.id }})</strong>
            </td>
        </tr>
        <tr>
            <td style="padding:28px;text-align:center;">
                <p style="margin:0 0 18px;font-size:16px;line-height:1.55;font-weight:600;color:#1f120f;">
                    Scan this QR code at the festival gate to open the festival door!
                </p>

                <div style="display:inline-block;padding:16px;background-color:#ffffff;border:2px solid #f3dfd3;border-radius:14px;">
                    <img src="cid:{{ qr_cid }}" alt="Festival Door 24h QR Code" width="220" height="220" style="display:block;border:0;">
                </div>

                <div style="margin:18px auto 0;max-width:400px;padding:12px 16px;background-color:#fff7ed;border:1px solid #fed7aa;border-radius:10px;color:#c2410c;font-size:13px;font-weight:700;">
                    Valid for 24 hours only &middot; Expires {{ expires_at }}
                </div>

                <div style="margin-top:22px;">
                    <a href="{{ door_url }}" style="display:inline-block;padding:12px 22px;background:linear-gradient(135deg,#d97706 0%,#ea580c 52%,#e11d48 100%);background-color:#ea580c;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:700;font-size:14px;">
                        Test Scanning at Festival Door &rarr;
                    </a>
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:24px;border-top:1px solid #f3dfd3;padding-top:16px;font-size:14px;color:#5c453e;text-align:left;">
                    <tr>
                        <td style="padding:5px 0;"><strong>Ticket ID:</strong> #{{ ticket.id }}</td>
                    </tr>
                    {% if ticket.event %}
                        <tr>
                            <td style="padding:5px 0;"><strong>Event:</strong> {{ ticket.event.title }} ({{ ticket.event.categoryLabel }})</td>
                        </tr>
                        <tr>
                            <td style="padding:5px 0;"><strong>Venue:</strong> {{ ticket.event.venue }}</td>
                        </tr>
                        {% if ticket.event.location %}
                            <tr>
                                <td style="padding:5px 0;">
                                    <strong>Location (Where to Go):</strong> {{ ticket.event.location }}
                                    {% if ticket.event.mapsUrl %}
                                        &middot; <a href="{{ ticket.event.mapsUrl }}" style="color:#ea580c;">Open in Maps</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}
                    {% endif %}
                    <tr>
                        <td style="padding:5px 0;"><strong>Pass Tier:</strong> {{ ticket.title }} ({{ ticket.formattedPrice }})</td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;"><strong>Digital Pass Link:</strong> <a href="{{ pass_url }}" style="color:#ea580c;">{{ pass_url }}</a></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
