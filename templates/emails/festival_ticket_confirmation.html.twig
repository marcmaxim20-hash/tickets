<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Your Festival Door 24h QR Ticket</title>
</head>
<body style="margin:0;padding:24px;background-color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background-color:#ffffff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;">
        <tr>
            <td style="background:linear-gradient(135deg,#312e81 0%,#059669 100%);background-color:#059669;padding:24px 28px;color:#ffffff;text-align:center;">
                <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;opacity:0.9;">Festival Main Gate Pass</div>
                <strong style="font-size:21px;display:block;margin-top:4px;">Festival Door QR Ticket (#{{ ticket.id }})</strong>
            </td>
        </tr>
        <tr>
            <td style="padding:28px;text-align:center;">
                <p style="margin:0 0 18px;font-size:16px;line-height:1.55;font-weight:600;color:#0f172a;">
                    Scan this QR code at the festival gate to open the festival door!
                </p>

                <div style="display:inline-block;padding:16px;background-color:#ffffff;border:2px solid #cbd5e1;border-radius:14px;">
                    <img src="cid:{{ qr_cid }}" alt="Festival Door 24h QR Code" width="220" height="220" style="display:block;border:0;">
                </div>

                <div style="margin:18px auto 0;max-width:400px;padding:12px 16px;background-color:#ecfdf5;border:1px solid #a7f3d0;border-radius:10px;color:#047857;font-size:13px;font-weight:700;">
                    Valid for 24 hours only &middot; Expires {{ expires_at }}
                </div>

                <div style="margin-top:22px;">
                    <a href="{{ door_url }}" style="display:inline-block;padding:12px 22px;background-color:#059669;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:700;font-size:14px;">
                        Test Scanning at Festival Door &rarr;
                    </a>
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:24px;border-top:1px solid #e2e8f0;padding-top:16px;font-size:14px;color:#475569;text-align:left;">
                    <tr>
                        <td style="padding:5px 0;"><strong>Ticket ID:</strong> #{{ ticket.id }}</td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;"><strong>Pass Title:</strong> {{ ticket.title }}</td>
                    </tr>
                    <tr>
                        <td style="padding:5px 0;"><strong>Digital Pass Link:</strong> <a href="{{ pass_url }}" style="color:#4f46e5;">{{ pass_url }}</a></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
