<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Recover Your SwiftDesk Password</title>
</head>
<body style="margin:0;padding:24px;background-color:#fffaf5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f120f;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:540px;margin:0 auto;background-color:#ffffff;border:1px solid #f3dfd3;border-radius:16px;overflow:hidden;">
        <tr>
            <td style="background:linear-gradient(135deg,#ea580c 0%,#e11d48 100%);background-color:#ea580c;padding:22px 28px;color:#ffffff;">
                <strong style="font-size:18px;">SwiftDesk Password Recovery</strong>
            </td>
        </tr>
        <tr>
            <td style="padding:28px;">
                <p style="margin:0 0 14px;font-size:16px;line-height:1.5;">
                    Hi <strong>{{ customer.name }}</strong>,
                </p>
                <p style="margin:0 0 22px;font-size:15px;line-height:1.6;color:#5c453e;">
                    We received a request to reset the password for your SwiftDesk account (<strong>{{ customer.email }}</strong>). Click the button below to choose a new password. This link expires in <strong>1 hour</strong>.
                </p>

                <div style="text-align:center;margin:26px 0;">
                    <a href="{{ reset_url }}" style="display:inline-block;padding:13px 26px;background:linear-gradient(135deg,#ea580c 0%,#e11d48 100%);background-color:#ea580c;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:700;font-size:15px;">
                        Reset My Password &rarr;
                    </a>
                </div>

                <p style="margin:20px 0 0;font-size:12px;color:#8a6d63;word-break:break-all;">
                    Or copy and paste this link into your browser:<br>
                    <a href="{{ reset_url }}" style="color:#ea580c;">{{ reset_url }}</a>
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
