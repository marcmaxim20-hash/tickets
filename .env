###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_local_dev_secret_key
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://ticket_user:ticket_password@database:3306/ticketing_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app/admin ###
